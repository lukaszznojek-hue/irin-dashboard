{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Propozycje nowych szkoleń",
  "type": "object",
  "required": ["propozycje"],
  "properties": {
    "data_aktualizacji": {"type": ["string", "null"]},
    "uzasadnienie": {"type": ["string", "null"]},
    "propozycje": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kod", "tytul"],
        "properties": {
          "kod": {"type": "string"},
          "tytul": {"type": "string"},
          "kategoria": {"type": ["string", "null"]},
          "uzasadnienie": {"type": ["string", "null"]},
          "estymowana_cena": {"type": ["number", "null"]},
          "estymowane_godziny": {"type": ["number", "null"]},
          "forma": {"type": ["string", "null"]},
          "powiazane_priorytety": {"type": ["array", "null"]},
          "rynek_target": {"type": ["string", "null"]},
          "pilnosc": {"type": ["string", "null"]},
          "status": {
            "type": ["string", "null"],
            "enum": ["pomysl", "analiza", "w_opracowaniu", "research_zakonczony", "gotowe", "odrzucone", null]
          },
          "owner_irin": {"type": ["string", "null"]},
          "data_promocji_do_oferty": {"type": ["string", "null"]},
          "url_program": {"type": ["string", "null"]},
          "folder_sprzedazowy": {"type": ["string", "null"]},
          "komentarze_zespolu": {"type": ["array", "null"]}
        }
      }
    }
  }
}
